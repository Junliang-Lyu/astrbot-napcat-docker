# Copy this file to .env before starting services.
# Keep .env private. Do not commit it to GitHub.

# Local timezone used by the containers.
TZ=Asia/Shanghai

# NapCat file ownership mapping.
# On Linux/macOS, set these to the output of: id -u and id -g
# On Windows Docker Desktop, 1000 is usually fine for local testing.
NAPCAT_UID=1000
NAPCAT_GID=1000

# Local-only host ports. docker-compose.yml binds them to 127.0.0.1.
ASTRBOT_WEBUI_PORT=6185
NAPCAT_WEBUI_PORT=6099

# Optional placeholders for later LLM setup.
# AstrBot is normally configured in the WebUI; these are notes/placeholders only.
LLM_PROVIDER=openai-compatible
LLM_API_BASE=https://api.example.com/v1
LLM_MODEL=example-model
LLM_API_KEY=replace-with-your-key

# Optional OneBot token placeholder.
# Only fill this if you also configure the same token in AstrBot and NapCat.
ONEBOT_ACCESS_TOKEN=replace-with-a-random-token
